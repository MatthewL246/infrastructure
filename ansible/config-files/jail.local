[DEFAULT]
bantime.increment = true
bantime.rndtime = 30m
bantime.maxtime = 2w
bantime.factor = 1
bantime.formula = ban.Time * (1<<(ban.Count if ban.Count<20 else 20)) * banFactor
bantime.overalljails = true

bantime = 30m
findtime = 30m
maxretry = 2

[sshd]
enabled = true
mode = aggressive
port = ssh
