// See https://headscale.net/stable/ref/acls/
{
  "tagOwners": {
    "tag:server": ["matthew@"]
  },
  "acls": [
    {
      "action": "accept",
      "src": ["matthew@"],
      "dst": ["*:*"]
    },
    // Allows all users to access their own devices
    {
      "action": "accept",
      "src": ["autogroup:member"],
      "dst": ["autogroup:self:*"]
    }
  ]
}
